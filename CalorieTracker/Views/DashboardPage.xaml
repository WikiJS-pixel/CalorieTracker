<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CalorieTracker.ViewModels"
             xmlns:models="clr-namespace:CalorieTracker.data.Models;assembly=CalorieTracker.data"
             xmlns:conv="clr-namespace:CalorieTracker.Converters"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="CalorieTracker.Views.DashboardPage"
             Title="Today's Progress"
             BackgroundColor="#F5F6FA"
             x:DataType="vm:DashboardViewModel">

    <ContentPage.Resources>
        <conv:ProgressToAngleConverter x:Key="ProgressToAngle" />
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        <conv:RemainingCaloriesToStringConverter x:Key="RemainingString" />
        <conv:RemainingCaloriesToColorConverter x:Key="RemainingColor" />
        <conv:MacroProgressConverter x:Key="MacroProgress" />
        <Style x:Key="QuickAddButtonStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#F0F2F5" />
            <Setter Property="TextColor" Value="{StaticResource Primary}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <Border StrokeShape="RoundRectangle 24" BackgroundColor="White" Padding="20" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.05" />
                    </Border.Shadow>

                    <Grid HeightRequest="280">
                        <Border Stroke="#F0F0F0" StrokeThickness="20" WidthRequest="240" HeightRequest="240"
                                StrokeShape="RoundRectangle 120" HorizontalOptions="Center" VerticalOptions="Center"/>

                        <Border Stroke="{Binding CalorieProgress, Converter={StaticResource ProgressToAngle}, ConverterParameter=Color}"
                                StrokeThickness="20" WidthRequest="240" HeightRequest="240"
                                StrokeShape="RoundRectangle 120"
                                Rotation="{Binding CalorieProgress, Converter={StaticResource ProgressToAngle}}"
                                HorizontalOptions="Center" VerticalOptions="Center"/>

                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding ConsumedCalories, StringFormat='{0:F0}'}"
                                   FontSize="48" FontAttributes="Bold" TextColor="#2D2D2D" HorizontalOptions="Center"/>
                            <Label Text="{Binding CalorieGoal, StringFormat='/ {0:F0} kcal'}"
                                   FontSize="16" TextColor="#A0A0A0" HorizontalOptions="Center"/>
                            <Label Text="{Binding RemainingCalories, Converter={StaticResource RemainingString}}"
                                   FontSize="22" FontAttributes="Bold" Margin="0,10,0,0"
                                   TextColor="{Binding RemainingCalories, Converter={StaticResource RemainingColor}}" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border StrokeShape="RoundRectangle 24" BackgroundColor="White" Padding="20" StrokeThickness="0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.05" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">
                        <Label Text="Daily Macros" FontSize="18" FontAttributes="Bold" TextColor="#2D2D2D"/>
                        <!-- Protein -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="Protein" TextColor="#666" FontSize="14" />
                                <Label Grid.Column="2" FontSize="14" FontAttributes="Bold">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:F0}g / {1:F0}g">
                                            <Binding Path="ConsumedProtein" />
                                            <Binding Path="GoalProtein" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>
                            <ProgressBar HeightRequest="12" ScaleY="2">
                                <ProgressBar.Progress>
                                    <MultiBinding Converter="{StaticResource MacroProgress}">
                                        <Binding Path="ConsumedProtein" />
                                        <Binding Path="GoalProtein" />
                                    </MultiBinding>
                                </ProgressBar.Progress>
                            </ProgressBar>
                        </VerticalStackLayout>
                        <!-- Carbs -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="Carbs" TextColor="#666" FontSize="14" />
                                <Label Grid.Column="2" FontSize="14" FontAttributes="Bold">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:F0}g / {1:F0}g">
                                            <Binding Path="ConsumedCarbs" />
                                            <Binding Path="GoalCarbs" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>
                            <ProgressBar HeightRequest="12" ScaleY="2" ProgressColor="{StaticResource Primary}">
                                <ProgressBar.Progress>
                                    <MultiBinding Converter="{StaticResource MacroProgress}">
                                        <Binding Path="ConsumedCarbs" />
                                        <Binding Path="GoalCarbs" />
                                    </MultiBinding>
                                </ProgressBar.Progress>
                            </ProgressBar>
                        </VerticalStackLayout>
                        <!-- Fat -->
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Label Text="Fat" TextColor="#666" FontSize="14" />
                                <Label Grid.Column="2" FontSize="14" FontAttributes="Bold">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0:F0}g / {1:F0}g">
                                            <Binding Path="ConsumedFat" />
                                            <Binding Path="GoalFat" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>
                            <ProgressBar HeightRequest="12" ScaleY="2" ProgressColor="{StaticResource Primary}">
                                <ProgressBar.Progress>
                                    <MultiBinding Converter="{StaticResource MacroProgress}">
                                        <Binding Path="ConsumedFat" />
                                        <Binding Path="GoalFat" />
                                    </MultiBinding>
                                </ProgressBar.Progress>
                            </ProgressBar>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>
                
                <!-- Recent meals -->
                <Label Text="Recent Meals" 
                       FontSize="20" 
                       FontAttributes="Bold" 
                       Margin="5,0,0,0" 
                       TextColor="#2D2D2D"
                       IsVisible="{Binding HasLoggedMeals}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Meals}" 
                                     Spacing="12"
                                     IsVisible="{Binding HasLoggedMeals}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:DashboardViewModel+MealSummary">
                            <Border StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="12" StrokeThickness="0">
                                <Grid ColumnDefinitions="60, *, Auto">
                                    <Label Text="{Binding Icon}" FontSize="32" VerticalOptions="Center" HorizontalOptions="Center"/>

                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="10,0">
                                        <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="16" TextColor="#2D2D2D"/>
                                        <Label Text="{Binding Calories, StringFormat='{0:F0} kcal'}" TextColor="#757575" FontSize="13"/>
                                    </VerticalStackLayout>

                                    <Button Text="+" Grid.Column="2" CornerRadius="15" WidthRequest="44" HeightRequest="44"
                                            BackgroundColor="{StaticResource Primary}" 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DashboardViewModel}}, Path=AddToMealCommand}"
                                            CommandParameter="{Binding Type}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Border IsVisible="{Binding HasLoggedMeals, Converter={StaticResource InvertedBoolConverter}}"
                        StrokeShape="RoundRectangle 24" 
                        BackgroundColor="White" 
                        Padding="20" 
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="20">
                        <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                            <Label Text="🍽️" FontSize="40" HorizontalOptions="Center"/>
                            <Label Text="Nothing logged yet" FontAttributes="Bold" FontSize="18" TextColor="#2D2D2D" HorizontalOptions="Center"/>
                            <Label Text="Start your day by logging a meal" TextColor="#757575" FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <FlexLayout Wrap="Wrap" JustifyContent="SpaceAround" AlignContent="Center" AlignItems="Center">
                            <Button Text="+ Breakfast" Command="{Binding AddToMealCommand}" CommandParameter="{x:Static models:MealType.Breakfast}" Style="{StaticResource QuickAddButtonStyle}"/>
                            <Button Text="+ Lunch" Command="{Binding AddToMealCommand}" CommandParameter="{x:Static models:MealType.Lunch}" Style="{StaticResource QuickAddButtonStyle}"/>
                            <Button Text="+ Dinner" Command="{Binding AddToMealCommand}" CommandParameter="{x:Static models:MealType.Dinner}" Style="{StaticResource QuickAddButtonStyle}"/>
                            <Button Text="+ Snack" Command="{Binding AddToMealCommand}" CommandParameter="{x:Static models:MealType.Snack}" Style="{StaticResource QuickAddButtonStyle}"/>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView IsVisible="{Binding IsBusy}" BackgroundColor="Black" Opacity="0.1" IsEnabled="False" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                   Color="{StaticResource Primary}" VerticalOptions="Center" 
                   HorizontalOptions="Center" Scale="1.5" />
    </Grid>
</ContentPage>