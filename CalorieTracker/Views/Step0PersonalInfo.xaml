<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalorieTracker.Views.Step0PersonalInfo">
    <StackLayout Spacing="25" Padding="20">
        <Label Text="Welcome to CalorieTracker!" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Let's start with some basic info" FontSize="18" HorizontalOptions="Center" />

        <Label Text="Your name" FontSize="16" />
        <Entry Text="{Binding Name}" Placeholder="Enter your name" />

        <Label Text="Birth date" FontSize="16" />
        <DatePicker Date="{Binding BirthDate}"
                    MaximumDate="{Binding Today}"
                    MinimumDate="{Binding MinBirthDate}" />

        <Label Text="Gender" FontSize="16" />
        <Picker ItemsSource="{Binding GenderOptions}"
                SelectedItem="{Binding Gender}" />
    </StackLayout>
</ContentView>