<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="CalorieTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:CalorieTracker.Views"
    xmlns:local="clr-namespace:CalorieTracker"
    Title="CalorieTracker">

    <TabBar>
        <!-- Dashboard Tab -->
        <ShellContent 
            Title="Home"
            Icon="tab_dashboard.png" 
            ContentTemplate="{DataTemplate views:DashboardPage}"
            Route="Dashboard" />

        <!-- Log Tab -->
        <ShellContent 
            Title="Log"
            Icon="tab_log.png" 
            ContentTemplate="{DataTemplate views:LogMealPage}"
            Route="LogMeal" />

        <!-- History Tab -->
        <ShellContent 
            Title="History"
            Icon="tab_history.png" 
            ContentTemplate="{DataTemplate views:HistoryPage}"
            Route="History" />

        <!-- Profile Tab -->
        <ShellContent 
            Title="Profile"
            Icon="tab_profile.png" 
            ContentTemplate="{DataTemplate views:ProfilePage}"
            Route="Profile" />
    </TabBar>

</Shell>
